#!/bin/bash

# Fallback if CONFIG_DIR not set by sketchybar
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
export CONFIG_DIR

source "$CONFIG_DIR/theme.sh"

##### Bar Appearance #####
# The bar itself is invisible. Two glass islands float on it, left and right,
# so the centre stays empty for the MacBook notch.
# blur_radius only applies to the bar's own (transparent) background; windows
# never reach under the islands anyway, so the glass is all in glass_island.
sketchybar --bar \
  position=top \
  topmost=window \
  height=40 \
  color=0x00000000 \
  shadow=off \
  padding_left=8 \
  padding_right=8 \
  margin=0 \
  y_offset=0

# glass_island NAME MEMBER... : stack five brackets around the same items.
# sketchybar has no gradients or inner shadows, so the glass is built from layers:
# base fill + drop shadow, two smaller translucent layers aligned to the top edge
# (a brightness gradient), and two offset hairline rims (lit top, shaded bottom).
glass_island() {
  local name=$1
  shift
  local layer
  for layer in "$name" "$name.glow1" "$name.glow2" "$name.hi" "$name.lo"; do
    sketchybar --add bracket "$layer" "$@" \
      --set "$layer" \
        background.drawing=on \
        background.color=0x00000000 \
        background.border_width=0 \
        background.height=32 \
        background.corner_radius=16
  done
  sketchybar \
    --set "$name" \
      background.color=$ISLAND_FILL \
      background.shadow.drawing=on \
      background.shadow.color=$ISLAND_SHADOW \
      background.shadow.angle=90 \
      background.shadow.distance=4 \
    --set "$name.glow1" \
      background.color=$ISLAND_GLOW \
      background.height=22 \
      background.corner_radius=11 \
      background.y_offset=5 \
    --set "$name.glow2" \
      background.color=$ISLAND_GLOW \
      background.height=12 \
      background.corner_radius=6 \
      background.y_offset=10 \
    --set "$name.hi" \
      background.border_width=1 \
      background.border_color=$ISLAND_RIM_HI \
      background.y_offset=1 \
    --set "$name.lo" \
      background.border_width=1 \
      background.border_color=$ISLAND_RIM_LO \
      background.y_offset=-1
}

##### Defaults #####
# Items sit directly on the island glass. background.* is only switched on for
# the focused workspace (plugins/workspaces.sh), as a lighter capsule.
default=(
  icon.font="$ICON_FONT"
  label.font="$LABEL_FONT"
  icon.color=$WHITE
  label.color=$WHITE
  icon.padding_left=8
  icon.padding_right=4
  label.padding_left=0
  label.padding_right=8
  padding_left=3
  padding_right=3
  background.height=22
  background.corner_radius=11
  background.color=$FOCUS_FILL
  background.border_width=0
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### Left: Apple #####
sketchybar --add item apple left \
  --set apple \
    icon="$ICON_APPLE" \
    icon.font="$FONT:Bold:16.0" \
    icon.padding_left=10 \
    icon.padding_right=8 \
    label.drawing=off \
    click_script="open -a 'System Settings'"

##### Left: Workspaces #####
# One pill per workspace: number, then the icons of the apps in it.
# A hidden observer repaints them all at once (plugins/workspaces.sh)
# whenever AeroSpace reports a change.
sketchybar --add event aerospace_change

for sid in "${WORKSPACES[@]}"; do
  sketchybar --add item space.$sid left \
    --set space.$sid \
      icon="$sid" \
      icon.font="$LABEL_FONT" \
      icon.color=$WHITE_50 \
      icon.padding_left=7 \
      icon.padding_right=4 \
      label="${WORKSPACE_ICONS[$sid]}" \
      label.font="$ICON_FONT" \
      label.color=$WHITE_50 \
      label.padding_right=6 \
      click_script="aerospace workspace $sid"
done

sketchybar --add item workspaces_observer left \
  --set workspaces_observer \
    drawing=off \
    updates=on \
    update_freq=30 \
    script="$PLUGIN_DIR/workspaces.sh" \
  --subscribe workspaces_observer aerospace_change front_app_switched

##### Left: Focused app #####
sketchybar --add item front_app left \
  --set front_app \
    icon.font="$APP_FONT" \
    icon.padding_left=8 \
    icon.padding_right=5 \
    padding_right=8 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

glass_island island.left apple "${WORKSPACES[@]/#/space.}" front_app

##### Right (added right-to-left) #####
sketchybar --add item calendar right \
  --set calendar \
    update_freq=10 \
    icon.drawing=off \
    label.padding_left=8 \
    padding_right=8 \
    script="$PLUGIN_DIR/calendar.sh" \
    click_script="$PLUGIN_DIR/click_calendar.sh"

sketchybar --add item battery right \
  --set battery \
    update_freq=10 \
    icon.font="$FONT:Bold:14.0" \
    script="$PLUGIN_DIR/battery.sh" \
    click_script="$PLUGIN_DIR/click_battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item wifi right \
  --set wifi \
    icon="$ICON_WIFI" \
    icon.padding_right=8 \
    label.drawing=off \
    click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'"

# Scroll over the volume pill to adjust it (plugins/volume.sh).
sketchybar --add item volume right \
  --set volume \
    icon="$ICON_VOLUME" \
    icon.padding_right=8 \
    padding_left=8 \
    label.drawing=off \
    scroll_texts=off \
    script="$PLUGIN_DIR/volume.sh" \
    click_script="$PLUGIN_DIR/click_sound.sh" \
  --subscribe volume volume_change mouse.scrolled

glass_island island.right volume wifi battery calendar

##### Initialize #####
sketchybar --update
