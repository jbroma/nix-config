#!/bin/bash

# Fallback if CONFIG_DIR not set by sketchybar
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
export CONFIG_DIR

source "$CONFIG_DIR/theme.sh"

##### Bar Appearance #####
# The bar itself is invisible. Two glass islands float on it, left and right,
# so the centre stays empty for the MacBook notch.
sketchybar --bar \
  position=top \
  topmost=window \
  height=40 \
  color=0x00000000 \
  shadow=off \
  padding_left=8 \
  padding_right=8 \
  margin=0 \
  y_offset=0

island=(
  background.drawing=on
  background.color=$BAR_BG
  background.border_color=$BAR_BORDER
  background.border_width=1
  background.height=32
  background.corner_radius=12
  blur_radius=64
)

# Helpers that outlive this script: restart them on every (re)load.
if command -v sketchybar-toggle >/dev/null 2>&1; then
  pkill -x sketchybar-toggle 2>/dev/null || true
  sketchybar-toggle >/dev/null 2>&1 &
fi
pkill -f aerospace_events.sh 2>/dev/null || true
"$PLUGIN_DIR/aerospace_events.sh" >/dev/null 2>&1 &

##### Defaults #####
# Every item is a hairline-outlined pill on the glass, no fill.
default=(
  icon.font="$ICON_FONT"
  label.font="$LABEL_FONT"
  icon.color=$WHITE
  label.color=$WHITE
  icon.padding_left=8
  icon.padding_right=4
  label.padding_left=0
  label.padding_right=8
  padding_left=3
  padding_right=3
  background.height=22
  background.corner_radius=7
  background.color=0x00000000
  background.border_color=$OUTLINE
  background.border_width=1
  background.drawing=on
)
sketchybar --default "${default[@]}"

##### Left: Apple #####
sketchybar --add item apple left \
  --set apple \
    icon="$ICON_APPLE" \
    icon.font="$FONT:Bold:16.0" \
    icon.padding_left=10 \
    icon.padding_right=8 \
    label.drawing=off \
    background.drawing=off \
    click_script="open -a 'System Settings'"

##### Left: Workspaces #####
# One pill per workspace: number, then the icons of the apps in it.
# A hidden observer repaints them all at once (plugins/workspaces.sh)
# whenever AeroSpace reports a change.
sketchybar --add event aerospace_change

for sid in "${WORKSPACES[@]}"; do
  sketchybar --add item space.$sid left \
    --set space.$sid \
      icon="$sid" \
      icon.font="$LABEL_FONT" \
      icon.color=$WHITE_50 \
      icon.padding_left=7 \
      icon.padding_right=4 \
      label="${WORKSPACE_ICONS[$sid]}" \
      label.font="$ICON_FONT" \
      label.color=$WHITE_50 \
      label.padding_right=6 \
      background.border_color=$OUTLINE_DIM \
      click_script="aerospace workspace $sid"
done

sketchybar --add item workspaces_observer left \
  --set workspaces_observer \
    drawing=off \
    updates=on \
    update_freq=30 \
    script="$PLUGIN_DIR/workspaces.sh" \
  --subscribe workspaces_observer aerospace_change front_app_switched

##### Left: Focused app #####
sketchybar --add item front_app left \
  --set front_app \
    icon.font="$APP_FONT" \
    icon.padding_left=8 \
    icon.padding_right=5 \
    padding_right=8 \
    background.drawing=off \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

sketchybar --add bracket island.left apple "${WORKSPACES[@]/#/space.}" front_app \
  --set island.left "${island[@]}"

##### Right (added right-to-left) #####
sketchybar --add item calendar right \
  --set calendar \
    update_freq=10 \
    icon.drawing=off \
    label.padding_left=8 \
    padding_right=8 \
    script="$PLUGIN_DIR/calendar.sh" \
    click_script="$PLUGIN_DIR/click_calendar.sh"

sketchybar --add item battery right \
  --set battery \
    update_freq=10 \
    icon.font="$FONT:Bold:14.0" \
    script="$PLUGIN_DIR/battery.sh" \
    click_script="$PLUGIN_DIR/click_battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item wifi right \
  --set wifi \
    icon="$ICON_WIFI" \
    icon.padding_right=8 \
    label.drawing=off \
    click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'"

# Scroll over the volume pill to adjust it (plugins/volume.sh).
sketchybar --add item volume right \
  --set volume \
    icon="$ICON_VOLUME" \
    icon.padding_right=8 \
    padding_left=8 \
    label.drawing=off \
    scroll_texts=off \
    script="$PLUGIN_DIR/volume.sh" \
    click_script="$PLUGIN_DIR/click_sound.sh" \
  --subscribe volume volume_change mouse.scrolled

sketchybar --add bracket island.right volume wifi battery calendar \
  --set island.right "${island[@]}"

##### Initialize #####
sketchybar --update
