#!/bin/bash

# Fallback if CONFIG_DIR not set by sketchybar
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
export CONFIG_DIR

source "$CONFIG_DIR/theme.sh"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  topmost=window \
  height=40 \
  color=$BAR_BG \
  border_color=$BAR_BORDER \
  border_width=1 \
  shadow=off \
  padding_left=2 \
  padding_right=2 \
  margin=10 \
  y_offset=0 \
  corner_radius=16 \
  blur_radius=64

# Helpers that outlive this script: restart them on every (re)load.
if command -v sketchybar-toggle >/dev/null 2>&1; then
  pkill -x sketchybar-toggle 2>/dev/null || true
  sketchybar-toggle >/dev/null 2>&1 &
fi
pkill -f aerospace_events.sh 2>/dev/null || true
"$PLUGIN_DIR/aerospace_events.sh" >/dev/null 2>&1 &

##### Defaults #####
default=(
  icon.font="$FONT:Bold:14.0"
  label.font="$FONT:SemiBold:12.0"
  icon.color=$WHITE
  label.color=$WHITE
  icon.padding_left=5
  icon.padding_right=5
  label.padding_left=3
  label.padding_right=5
  padding_left=2
  padding_right=2
  background.height=30
  background.corner_radius=10
  background.color=$PILL_BG
  background.border_color=$PILL_BORDER
  background.border_width=1
  # Last on purpose: setting background.color switches drawing back on.
  background.drawing=off
)
sketchybar --default "${default[@]}"

##### Left: Apple #####
sketchybar --add item apple left \
  --set apple \
    icon="$ICON_APPLE" \
    icon.font="$FONT:Bold:20.0" \
    icon.padding_left=10 \
    icon.padding_right=8 \
    label.drawing=off \
    click_script="open -a 'System Settings'"

##### Left: Workspaces #####
# One item per workspace; a hidden observer repaints all of them at once
# (plugins/workspaces.sh) whenever AeroSpace reports a change.
sketchybar --add event aerospace_change

for sid in "${!WORKSPACE_ICONS[@]}"; do
  sketchybar --add item space.$sid left \
    --set space.$sid \
      icon="${WORKSPACE_ICONS[$sid]}" \
      icon.font="$ICON_FONT" \
      icon.color=$WHITE_50 \
      icon.padding_left=7 \
      icon.padding_right=3 \
      label="$sid" \
      label.color=$WHITE_50 \
      label.font="$FONT:Bold:11.0" \
      label.padding_left=0 \
      label.padding_right=7 \
      click_script="aerospace workspace $sid"
done

sketchybar --add item workspaces_observer left \
  --set workspaces_observer \
    drawing=off \
    updates=on \
    update_freq=30 \
    script="$PLUGIN_DIR/workspaces.sh" \
  --subscribe workspaces_observer aerospace_change front_app_switched

##### Left: Focused app #####
sketchybar --add item front_app left \
  --set front_app \
    icon.font="$APP_FONT" \
    icon.padding_left=10 \
    icon.padding_right=4 \
    label.font="$FONT:Bold:12.0" \
    label.padding_right=10 \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Right: Status Pills #####
sketchybar --add item date right \
  --set date \
    update_freq=60 \
    icon.drawing=off \
    label.font="$FONT:Bold:12.0" \
    label.padding_left=10 \
    label.padding_right=10 \
    background.drawing=on \
    script="$PLUGIN_DIR/date.sh" \
    click_script="$PLUGIN_DIR/click_calendar.sh"

sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon.drawing=off \
    label.font="$FONT:Bold:12.0" \
    label.padding_left=10 \
    label.padding_right=10 \
    background.drawing=on \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="$PLUGIN_DIR/click_clock.sh"

sketchybar --add item battery right \
  --set battery \
    update_freq=10 \
    icon.font="$FONT:Bold:16.0" \
    icon.padding_left=10 \
    icon.padding_right=4 \
    label.font="$FONT:Bold:11.0" \
    label.padding_left=0 \
    label.padding_right=10 \
    background.drawing=on \
    script="$PLUGIN_DIR/battery.sh" \
    click_script="$PLUGIN_DIR/click_battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item wifi right \
  --set wifi \
    icon="$ICON_WIFI" \
    icon.padding_left=10 \
    icon.padding_right=10 \
    label.drawing=off \
    background.drawing=on \
    click_script="open 'x-apple.systempreferences:com.apple.Network-Settings.extension'"

# Scroll over the volume pill to adjust it (plugins/volume.sh).
sketchybar --add item volume right \
  --set volume \
    icon="$ICON_VOLUME" \
    icon.padding_left=10 \
    icon.padding_right=10 \
    label.drawing=off \
    background.drawing=on \
    scroll_texts=off \
    script="$PLUGIN_DIR/volume.sh" \
    click_script="$PLUGIN_DIR/click_sound.sh" \
  --subscribe volume volume_change mouse.scrolled

##### Initialize #####
sketchybar --update
